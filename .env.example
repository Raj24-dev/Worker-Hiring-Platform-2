NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Signs the OTP challenge cookie and derives each account's Supabase password.
# Rotating this logs everyone out and orphans existing accounts. Keep it stable.
AUTH_SECRET=generate-with-openssl-rand-hex-32

# Identity verification is simulated — there is no SMS gateway and no UIDAI
# licence behind it. Every one-time code (phone login and Aadhaar) is 9254 and
# is never shown on screen. Set to false to restore random codes and the real
# Aadhaar checksum; see lib/demo.ts.
NEXT_PUBLIC_DEMO_MODE=true

# Setu — the voice assistant that onboards workers who cannot fill a form.
# Sarvam does speech-to-text (auto-detects the Indian language) and text-to-speech.
SARVAM_API_KEY=your-sarvam-key
# Gemini drives the conversation and writes the profile remarks.
GEMINI_API_KEY=your-gemini-key
