NEXT_PUBLIC_SUPABASE_URL=https://zfrdpfampvxgdgzbsenf.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Signs the OTP challenge cookie and derives each account's Supabase password.
# Rotating this logs everyone out and orphans existing accounts. Keep it stable.
AUTH_SECRET=generate-with-openssl-rand-hex-32

# Demo mode: no SMS gateway exists, so every OTP is this fixed code and the
# screen simply confirms "OTP sent". REMOVE THIS LINE for real use — without it
# the code is random, which is the only thing stopping anyone signing in as
# anyone who knows a phone number.
DEMO_OTP=9254

# Setu — the voice assistant that onboards workers who cannot fill a form.
# Sarvam does speech-to-text (auto-detects the Indian language) and text-to-speech.
SARVAM_API_KEY=your-sarvam-key
# Gemini drives the conversation and writes the profile remarks.
GEMINI_API_KEY=your-gemini-key
