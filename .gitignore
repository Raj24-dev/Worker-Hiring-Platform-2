# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies — at any depth, not just the repo root
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real values never ship, but the template must
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local editor / agent tooling
.claude/

# The original standalone Setu prototype this project ports from. It carries
# its own .env with live API keys and its own node_modules, so it stays out of
# the repository; its logic now lives in lib/setu and app/api/setu.
/setu/
